# লোকাল ডেভ: এই ফাইলটা .env নামে কপি করুন
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
# খালি রাখলে sqlite ব্যবহার হবে। Supabase হলে নিচের মতো দিন:
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000
ADMIN_PHONE=01700000000
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Admin
# --- SMS / OTP (BulkSMSBD). লোকালে খালি রাখলে OTP কোড API রেসপন্সে (dev_code) দেখাবে ---
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
